{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Backend (.NET)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/OficiosYa.Web/bin/Debug/net9.0/OficiosYa.Web.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/OficiosYa.Web",
      "console": "internalConsole",
      "stopAtEntry": false
    },
    {
      "name": "Launch Frontend (Vue)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/src/frontend-oficiosya/node_modules/.bin/vite",
      "args": ["--port", "3000"],
      "cwd": "${workspaceFolder}/src/frontend-oficiosya",
      "console": "integratedTerminal",
      "env": {
        "NODE_ENV": "development"
      }
    }
  ],
  "compounds": [
    {
      "name": "Launch Full Stack",
      "configurations": ["Launch Backend (.NET)", "Launch Frontend (Vue)"]
    }
  ]
}
