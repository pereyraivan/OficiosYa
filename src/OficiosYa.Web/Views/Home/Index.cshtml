@{
    ViewData["Title"] = "Inicio";
}

<!-- Hero -->
<section class="hero" id="inicio">
    <div class="container hero-wrap">
        <div>
            <h1>Encontrá al profesional que necesitás, <br> en tu zona</h1>
            <p>Electricistas, plomeros, albañiles, gasistas, jardineros y mucho más. Compará perfiles, reseñas y contactá directo.</p>
            <form class="search" id="searchForm">
                <div class="chip">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M3 7h18M3 12h18M3 17h18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                    </svg>
                    <select id="oficio" name="oficio" aria-label="Oficio" style="border:0;outline:none;width:100%;background:transparent">
                        <option value="">Todos los oficios</option>
                    </select>
                </div>
                <div class="chip">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 21s8-6.1 8-12a8 8 0 1 0-16 0c0 5.9 8 12 8 12Z" stroke="currentColor" stroke-width="2"/>
                        <circle cx="12" cy="9" r="3" stroke="currentColor" stroke-width="2"/>
                    </svg>
                    <input id="ciudad" name="ciudad" aria-label="Ciudad" placeholder="Ej: San Miguel de Tucumán" style="border:0;outline:none;width:100%;background:transparent" />
                </div>
                <button type="submit">Buscar</button>
            </form>
            <div style="margin-top:14px" class="small">Tip: pronto podrás <b>dibujar tu zona</b> en el mapa para resultados más precisos.</div>
        </div>
        <div class="hero-card">
            <span class="badge">Nuevos perfiles verificados</span>
            <h3 style="margin-top:10px">Profesionales cerca tuyo</h3>
            <div id="destacadosContainer" style="display:grid;grid-template-columns:repeat(2,1fr);gap:12px">
                <!-- Los profesionales destacados se cargarán aquí con TypeScript -->
            </div>
        </div>
    </div>
</section>

<!-- Categorías -->
<section class="section" id="categorias">
    <div class="container">
        <h2>Explorá categorías populares</h2>
        <p class="muted">Elegí una categoría para ver profesionales cerca de tu ubicación.</p>
        <div class="grid" style="margin-top:16px" id="oficiosDropdown">
            <!-- Las categorías se cargarán aquí con TypeScript -->
        </div>
    </div>
</section>

<!-- Cómo funciona -->
<section class="section" id="como-funciona" style="background:#f8fafc">
    <div class="container">
        <h2>¿Cómo funciona?</h2>
        <div class="steps" style="margin-top:12px">
            <div class="step">
                <div class="badge" style="background:#e0f2fe;color:#075985">Paso 1</div>
                <h3>Buscá por oficio y zona</h3>
                <p class="muted">Usá el buscador o elegí una categoría. Podrás filtrar por distancia, precio y valoración.</p>
            </div>
            <div class="step">
                <div class="badge" style="background:#dcfce7;color:#14532d">Paso 2</div>
                <h3>Compará perfiles verificados</h3>
                <p class="muted">Mirá fotos de trabajos, certificaciones y reseñas reales de clientes.</p>
            </div>
            <div class="step">
                <div class="badge" style="background:#fef9c3;color:#854d0e">Paso 3</div>
                <h3>Contactá y contratá</h3>
                <p class="muted">Enviá un mensaje o pedí presupuesto sin compromiso. ¡Listo!</p>
            </div>
        </div>
    </div>
</section>

<!-- Testimonios -->
<section class="section" style="background:#f8fafc">
    <div class="container">
        <h2>Lo que dicen nuestros usuarios</h2>
        <div class="testis" style="margin-top:16px">
            <blockquote class="testi">"Conseguí electricista en 5 minutos y resolvió el mismo día."<div class="small" style="margin-top:6px">— Sofía, SM de Tucumán</div></blockquote>
            <blockquote class="testi">"Me encantó poder ver reseñas y fotos de trabajos reales."<div class="small" style="margin-top:6px">— Martín, Yerba Buena</div></blockquote>
            <blockquote class="testi">"Como profesional, recibo pedidos todas las semanas."<div class="small" style="margin-top:6px">— Daniela, Plomería</div></blockquote>
        </div>
    </div>
</section>

<!-- CTA profesional -->
<section class="section">
    <div class="container">
        <div class="cta-block">
            <div>
                <h2 style="margin:0 0 6px">¿Sos profesional? Empezá a recibir trabajos</h2>
                <div class="small" style="color: white;">Registrate gratis, subí tus certificaciones y elegí tu zona de trabajo.</div>
            </div>
            <button onclick="window.location.href='/Profesional/Registrar'">Crear cuenta de profesional</button>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        // Inicializar la aplicación cuando la página esté lista
        document.addEventListener('DOMContentLoaded', function() {
            // La aplicación se inicializa automáticamente desde app.js
        });
    </script>
}
