<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - OficiosYa</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
</head>
<body>
    <!-- Header -->
    <header>
        <div class="container nav">
            <div class="logo">
                <div class="logo-badge">🛠️</div>
                <span>OficiosYa</span>
            </div>
            <nav class="navlinks">
                <a href="#inicio">Inicio</a>
                <a href="#categorias">Profesionales</a>
                <a href="#como-funciona">Cómo funciona</a>
                <a href="#">Ayuda</a>
                <button class="cta" onclick="window.location.href='/Profesional/Registrar'">Publicar tu servicio</button>
            </nav>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer>
        <div class="container footer">
            <div>
                <div class="logo" style="color:white"><div class="logo-badge">🛠️</div><span>OficiosYa</span></div>
                <p class="small" style="margin-top:8px">Conectamos personas con profesionales de confianza en su zona.</p>
            </div>
            <div>
                <strong>Explorar</strong>
                <div class="small" style="margin-top:8px"><a href="#categorias" style="color:inherit">Categorías</a></div>
                <div class="small"><a href="/Buscar" style="color:inherit">Profesionales</a></div>
            </div>
            <div>
                <strong>Ayuda</strong>
                <div class="small" style="margin-top:8px"><a href="#" style="color:inherit">Centro de ayuda</a></div>
                <div class="small"><a href="#" style="color:inherit">Contacto</a></div>
            </div>
            <div>
                <strong>Legal</strong>
                <div class="small" style="margin-top:8px"><a href="#" style="color:inherit">Términos</a></div>
                <div class="small"><a href="#" style="color:inherit">Privacidad</a></div>
            </div>
        </div>
        <div class="container" style="padding:12px 0;border-top:1px solid #1f2937;color:#94a3b8">
            <div class="small">© 2025 OficiosYa</div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/js/app.js"></script>
    <script src="~/js/services/api.js"></script>
    <script src="~/js/services/usuarioService.js"></script>
    <script src="~/js/services/oficioService.js"></script>
    <script src="~/js/components/auth.js"></script>
    <script src="~/js/components/search.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
